          }
        },
        "$type": "number",
        "$value": "{spacing.16}",
        "$description": "页面两侧留白；Comfortable 24 px，Compact 16 px。"
      }
    }
  },
  "compatibility": {
    "layout": {
      "radius": {
        "$extensions": {
          "com.figma.scopes": [
            "CORNER_RADIUS"
          ],
          "com.figma.hiddenFromPublishing": false,
          "com.figma.codeSyntax": {
            "Web": "var(--layout-radius)"
          }
        },
        "$type": "number",
        "$value": "{radii.surface.card}",
        "$description": "兼容原 layout/radius；保留变量 ID、--layout-radius 代码名称和 24 px 外观。新设计请使用 SemanticRadii/radii/surface/card。"
      }
    }
  }
}