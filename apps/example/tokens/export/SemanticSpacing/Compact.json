        "$value": "{spacing.8}",
        "$description": "控件内边距；Comfortable 12 px，Compact 8 px。"
      },
      "card": {
        "$extensions": {
          "com.figma.scopes": [
            "GAP"
          ],
          "com.figma.hiddenFromPublishing": false,
          "com.figma.codeSyntax": {
