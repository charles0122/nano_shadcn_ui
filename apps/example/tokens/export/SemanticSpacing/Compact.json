{
  "spacing": {
    "inset": {
      "default": {
        "$extensions": {
          "com.figma.scopes": [
            "GAP"
          ],
          "com.figma.hiddenFromPublishing": false,
          "com.figma.codeSyntax": {
            "Web": "var(--spacing-inset-default)"
          }
        },
        "$type": "number",
        "$value": "{spacing.16}",
        "$description": "默认容器内边距；Comfortable 24 px，Compact 16 px。保留原 layout/padding 的变量 ID 和模式值。"
      },
      "control": {
