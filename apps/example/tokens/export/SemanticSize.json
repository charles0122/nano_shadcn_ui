        "$extensions": {
          "com.figma.scopes": [
            "WIDTH_HEIGHT"
          ],
          "com.figma.hiddenFromPublishing": false,
          "com.figma.codeSyntax": {
            "Web": "var(--size-icon-inline)"
          }
        },
        "$type": "number",
        "$value": "{size.16}",
        "$description": "语义尺寸：icon/inline，单位 px。"
