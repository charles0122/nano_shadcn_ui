{
  "$description": "Type scale — font sizes (px), weights, line heights (unitless) and family.",
  "family": {
    "sans": { "$type": "fontFamily", "$value": "Roboto" }
  },
  "font-size": {
    "sm": { "$type": "dimension", "$value": 12 },
    "md": { "$type": "dimension", "$value": 14 },
    "lg": { "$type": "dimension", "$value": 16 },
    "xl": { "$type": "dimension", "$value": 20 },
    "2xl": { "$type": "dimension", "$value": 28 }
  },
  "font-weight": {
    "regular": { "$type": "fontWeight", "$value": 400 },
    "medium": { "$type": "fontWeight", "$value": 500 },
    "semibold": { "$type": "fontWeight", "$value": 600 },
    "bold": { "$type": "fontWeight", "$value": 700 }
  },
  "line-height": {
    "tight": { "$type": "number", "$value": 1.2 },
    "normal": { "$type": "number", "$value": 1.45 }
  }
}
